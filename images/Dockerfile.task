# syntax=docker/dockerfile:1
# task-rootfs is generated by prepare_image_context.py from verified release
# task assets plus the data/setup snapshot in the published original SIF.
ARG SOFTWARE_IMAGE
FROM scratch AS task-data
COPY task-rootfs/ /
FROM ${SOFTWARE_IMAGE}
ARG TASK_WORKDIR=/app
COPY --from=task-data / /
COPY tools/entrypoint.sh /usr/local/bin/dbt-bench-entrypoint
WORKDIR ${TASK_WORKDIR}
ENV DB_TYPE=duckdb
ENTRYPOINT ["/usr/local/bin/dbt-bench-entrypoint"]
CMD ["/bin/bash"]
