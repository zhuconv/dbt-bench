+    async def _terminate_server(self, grace_seconds: float = 5.0) -> None:
+        """Reap the dedicated container session, including an orphaned runtime.
+
+        Apptainer's launcher may exit before its runtime parent and namespace
+        init. Signalling only the launcher, then looking up its children, loses
+        those reparented processes. Each launch below owns a new session.
+        """
+        process = getattr(self, "_server_process", None)
+        if process is None:
+            return
+        try:
+            if os.getpgid(process.pid) != process.pid:
+                raise RuntimeError("Refusing to signal a container without its own process group")
+        except ProcessLookupError:
+            pass  # The launcher exited; its dedicated process group can remain.
+        try:
+            os.killpg(process.pid, signal.SIGTERM)
+            self.logger.debug(f"Sent SIGTERM to container process group {process.pid}")
+        except ProcessLookupError:
+            pass
+        if grace_seconds > 0:
+            try:
+                await asyncio.wait_for(asyncio.shield(process.wait()), timeout=grace_seconds)
+            except asyncio.TimeoutError:
+                self.logger.debug("Container shutdown timed out; killing remaining group members")
+        # Also handle descendants that ignored TERM after their launcher exited.
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        await asyncio.wait_for(process.wait(), timeout=5.0)
+        self._server_process = None
+
